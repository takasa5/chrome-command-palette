{
  "manifest_version": 3,
  "name": "Command Palette",
  "version": "0.1.0",
  "description": "Cmd+T で開くコマンドパレット。ブラウザ操作、タブ切り替え、履歴・ブックマーク検索をキーボードで行う。",
  "minimum_chrome_version": "138",
  "permissions": ["tabs", "history", "bookmarks", "sessions", "search", "favicon", "clipboardWrite", "storage", "scripting", "activeTab", "readingList", "offscreen"],
  "host_permissions": ["https://x.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "open-palette": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "今のページの上にパレットを開く"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "palette.html"
  }
}
